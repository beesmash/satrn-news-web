---
import Layout from '../layouts/SiteLayout.astro';
import articles from '../data/articles.json';
import {preview} from '../data/designPreview.js';
import PreviewCard from '../components/PreviewCard.astro';
import SectionGroup from '../components/SectionGroup.astro';
import {storyBelongsTo} from '../data/sections.js';
const live=articles.filter(a=>a.status==='published').sort((a,b)=>b.date.localeCompare(a.date));
const designMode=live.length===0;
const link=s=>s.slug?'/news/'+s.slug+'/':'/'+(s.section||'news')+'/';
const pick=(name,slug,limit)=>designMode?preview[name].slice(0,limit):live.filter(a=>storyBelongsTo(a,slug)).slice(0,limit);
const lead=live[0]||preview.lead;
const hero=designMode?preview.hero:live.slice(1,5);
const latest=designMode?preview.latest:live.slice(0,5);
const topHeadlines=designMode?preview.headlines:live.slice(0,5).map(a=>a.title);
---
<Layout active="/" heroImage={lead.image}>
 {designMode && <div class="preview-disclaimer"><div class="page-container"><strong>DESIGN PREVIEW</strong> · Illustrative May 2025 headlines and stock imagery. This is a visual layout test, not current news or published SATRN reporting.</div></div>}
 <div class="page-container home">
  <section class="lead-grid" aria-label="Featured news">
   <article class="lead-large" style={'--img:url("'+lead.image+'")'}>
    <img class="lead-photo" src={lead.image} alt="" loading="eager" decoding="sync" fetchpriority="high"/>
    <div class="lead-overlay"><span class="tag">{lead.category}</span><h1><a href={link(lead)}>{lead.title}</a></h1>
    <p>{lead.summary||'Nations explore new approaches to the world’s most consequential challenges.'}</p>
    <div class="lead-byline">{designMode?'ILLUSTRATIVE · ':''}{lead.date}</div></div>
   </article>
   <div class="lead-side">{hero.map((s,i)=><article class="lead-small">
    <img src={s.image} alt="" loading={designMode ? "eager" : i===0 ? "eager" : "lazy"} decoding="async"/>
    <div class="lead-overlay"><span class="tag">{s.category}</span><h2><a href={link(s)}>{s.title}</a></h2></div>
   </article>)}</div>
  </section>
  <section class="headline-strip"><strong>TOP HEADLINES</strong><div class="headline-items">{topHeadlines.map(t=><span>{t}</span>)}</div></section>
  <section class="home-section"><div class="section-title"><h2>LATEST NEWS</h2><a href="/news/">View All →</a></div>
   <div class="latest-grid">{latest.map(s=><PreviewCard story={s}/>)}</div>
  </section>
  <div class="three-news-columns">
   <SectionGroup title="WORLD NEWS" slug="world-news" stories={pick('world','world-news',3)}/>
   <SectionGroup title="U.S. NEWS" slug="us-news" stories={pick('us','us-news',3)}/>
   <SectionGroup title="POLITICS" slug="us-politics" stories={pick('politics','us-politics',3)}/>
  </div>
 </div>
 <section class="janus-area"><div class="page-container">
  <div class="section-title section-title-dark"><h2><span class="janus-bullet">✦</span> JANUS INTELLIGENCE</h2><p>Exclusive analysis and forward-looking insights.</p><a href="/janus-intelligence/">View All Intelligence →</a></div>
  <div class="janus-grid">{pick('janus','janus-intelligence',4).map(s=><article class="janus-story">
   <a href={link(s)}><img src={s.image} alt="" loading={designMode ? "eager" : "lazy"} decoding="async"/><span class="janus-label">{s.category}</span></a>
   <h3><a href={link(s)}>{s.title}</a></h3><div class="pv-meta">{designMode?'ILLUSTRATIVE · ':''}{s.date}</div>
  </article>)}</div>
 </div></section>
 <div class="page-container">
  <div class="business-market-row">
   <SectionGroup title="BUSINESS" slug="business" stories={pick('business','business',3)}/>
   <section class="news-group"><div class="section-title"><h2>FINANCIAL MARKETS</h2><a href="/markets/">View All →</a></div><div class="market-layout">
    {pick('markets','markets',1).map(s=><PreviewCard story={s} variant="market-lead"/>)}
    <div class="market-list">{pick('markets','markets',4).slice(1).map(s=><PreviewCard story={s} variant="compact"/>)}</div>
   </div></section>
  </div>
  <div class="science-tech-row">
   <SectionGroup title="SCIENCE" slug="science" stories={pick('science','science',3)}/>
   <section class="news-group"><div class="section-title"><h2>TECHNOLOGY</h2><a href="/technology/">View All →</a></div><div class="market-layout">
     {pick('technology','technology',1).map(s=><PreviewCard story={s} variant="market-lead"/>)}
     <div class="market-list">{pick('technology','technology',4).slice(1).map(s=><PreviewCard story={s} variant="compact"/>)}</div>
   </div></section>
  </div>
  <div class="three-news-columns second-triple">
   <SectionGroup title="ENVIRONMENT" slug="environment" stories={pick('environment','environment',3)}/>
   <SectionGroup title="SOCIETY" slug="society" stories={pick('society','society',3)}/>
   <SectionGroup title="WORLD PROGRESS" slug="world-progress" stories={pick('progress','world-progress',3)}/>
  </div>
  <div class="three-news-columns third-triple">
   <SectionGroup title="CULTURE" slug="culture" stories={pick('culture','culture',3)}/>
   <SectionGroup title="LIFESTYLE" slug="lifestyle" stories={pick('lifestyle','lifestyle',3)}/>
   <SectionGroup title="SPORT" slug="sport" stories={pick('sport','sport',3)}/>
  </div>
  <div class="broadcast-row">
   <section class="news-group"><div class="section-title"><h2>SATRN TV</h2><a href="https://satrn.tv/" target="_blank" rel="noopener noreferrer">View All ↗</a></div><div class="tv-grid">{preview.videos.map(s=><PreviewCard story={s} variant="video" showDate={false}/>)}</div></section>
   <section class="news-group"><div class="section-title"><h2>SATRN AUDIO</h2><a href="/satrn-audio/">View All →</a></div><div class="audio-panel">
    <h3>SATRN NEWS HOURLY UPDATE</h3><p>Top stories you need to know, right now.</p>
    <div class="audio-preview-control"><span class="audio-play-icon" aria-hidden="true">▶</span><span class="audio-wave" aria-hidden="true"></span><span class="audio-duration">AUDIO COMING SOON</span></div>
    <div class="audio-latest"><strong>LATEST EPISODES</strong><div>Hourly News Update</div><div>What's Next in Global Markets</div><div>Janus Intelligence Podcast</div></div>
   </div></section>
  </div>
 </div>
 <section class="newsletter-banner"><div class="page-container newsletter-layout"><h2>QUESTION<br/>EVERYTHING.</h2><div><p>Get the stories that matter, delivered<br/> with context and clarity.</p><div class="newsletter-preview">Newsletter sign-ups will be available after the publishing service is connected.</div><small>No sign-up form is active on this design preview.</small></div></div></section>
 <div class="page-container"><section class="home-section more-news-section"><div class="section-title"><h2>MORE NEWS</h2><a href="/news/">View All →</a></div><div class="more-grid">{(designMode?preview.more:live.slice(5,11)).map(s=><PreviewCard story={s}/>)}</div></section></div>
</Layout>
