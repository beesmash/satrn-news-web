---
import Layout from '../../layouts/SiteLayout.astro';
import articles from '../../data/articles.json';
import editions from '../../data/editions.json';
import {publishedArticles,publishedEditions,articlePath,editionPath} from '../../lib/publication.mjs';
const indexed=[
 ...publishedArticles(articles).map(a=>({title:a.title,summary:a.summary,category:a.category,date:a.date,type:"Article",url:articlePath(a.slug)})),
 ...publishedEditions(editions).map(e=>({title:e.title,summary:e.summary,category:e.type.replaceAll("-"," "),date:e.date,type:"Newspaper",url:editionPath(e.slug)}))
];
---
<Layout title="Search SATRN News">
 <div class="page-container archive-header"><div class="kicker">SATRN NEWS · PUBLIC ARCHIVE</div><h1>Search</h1><p>Search published articles and complete newspaper editions.</p></div>
 <div class="page-container search-area">
  <label for="search-query">Search SATRN News</label>
  <input type="search" id="search-query" placeholder="Search headlines, topics, categories or newspapers" autocomplete="off"/>
  <p role="status" aria-live="polite" id="search-count">Enter a search term to begin.</p>
  <div id="search-results"></div>
 </div>
 <script type="application/json" id="satrn-search-data" set:html={JSON.stringify(indexed).replace(/</g,"\\u003c")}></script>
 <script>
 const input=document.getElementById("search-query"),target=document.getElementById("search-results"),count=document.getElementById("search-count");
 const items=JSON.parse(document.getElementById("satrn-search-data")?.textContent||"[]");
 const render=()=>{
  if(!input||!target||!count)return;
  const term=input.value.trim().toLocaleLowerCase();
  target.replaceChildren();
  if(!term){count.textContent="Enter a search term to begin.";return;}
  const matches=items.filter(x=>[x.title,x.summary,x.category,x.date,x.type].join(" ").toLocaleLowerCase().includes(term)).slice(0,60);
  count.textContent=matches.length+" published result"+(matches.length===1?"":"s");
  matches.forEach(item=>{
   const el=document.createElement("article");el.className="search-result";
   const label=document.createElement("span");label.className="kicker";label.textContent=item.type+" · "+item.category+" · "+item.date;
   const link=document.createElement("a");link.href=item.url;link.textContent=item.title;
   const desc=document.createElement("p");desc.textContent=item.summary;
   el.append(label,link,desc);target.append(el);
  });
 };
 input?.addEventListener("input",render);
 const initial=new URLSearchParams(window.location.search).get("q");
 if(initial&&input){input.value=initial.slice(0,150);render();}
 </script>
</Layout>
