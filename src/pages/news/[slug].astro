---
import Layout from '../../layouts/SiteLayout.astro';
import articles from '../../data/articles.json';
export function getStaticPaths() {
  return articles.filter(article => article.status === 'published').map(article => ({ params:{slug:article.slug}, props:{article} }));
}
const { article } = Astro.props;
---
<Layout title={article.title} description={article.summary}>
  <article class="wrap article-page"><div class="eyebrow">{article.category} · {article.date}</div><h1>{article.title}</h1><p class="article-deck">{article.summary}</p><div class="article-byline">By {article.author || 'SATRN News'} · {article.date}</div>{article.image && <figure><img src={article.image} alt={article.imageAlt || ''}/>{article.imageCaption && <figcaption>{article.imageCaption}</figcaption>}</figure>}<div class="article-body">{article.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div><a class="text-link" href="/news/">← Back to newsroom</a></article>
</Layout>
