---
import '../styles/site.css';
import articles from '../data/articles.json';
const {title='SATRN News',description='Independent news, analysis, global reporting and investigations.',active='',heroImage}=Astro.props;
const published=articles.filter(a=>a.status==='published');
const breaking=published.filter(a=>a.breaking).slice(0,3);
const menus=[
 ['/', 'Home'],['/news/','News'],['/janus-intelligence/','Intelligence'],
 ['/opinion/','Opinion'],['/markets/','Markets'],['/sport/','Sport'],
 ['/culture/','Culture'],['/lifestyle/','Lifestyle']
];
---
<!doctype html><html lang="en"><head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
 <meta name="description" content={description}/><meta name="theme-color" content="#ffffff"/>
 {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high"/>}
 <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
 <title>{title==='SATRN News'?title:title+' | SATRN News'}</title>
</head><body>
 <a href="#main" class="skip-link">Skip to content</a>
 <div class="utility-bar"><div class="page-container utility-inner">
  <span id="today-dc">WASHINGTON, D.C.</span>
  <span class="utility-icons"><a href="https://satrn.tv/" target="_blank" rel="noopener noreferrer">SATRN.TV</a><a href="/about/">About</a><a href="/contact/">Contact</a></span>
 </div></div>
 <div class="breaking-bar"><div class="page-container breaking-inner">
  <span class="breaking-chip">BREAKING NEWS</span>
  <span class="breaking-time" id="today-time">SATRN NEWS</span>
  {breaking.length ? <a href={'/news/'+breaking[0].slug+'/'}>{breaking[0].title}</a> : <span class="breaking-placeholder">SATRN News v2 · Editorial publishing infrastructure in development</span>}
  <a href="/news/" class="breaking-all">View All →</a>
 </div></div>
 <header class="site-header"><div class="page-container header-main">
  <a class="masthead-logo" href="/" aria-label="SATRN News homepage"><img src="/satrn-news-logo.svg" width="218" height="66" alt="SATRN News"/></a>
  <nav aria-label="Primary navigation" class="primary-nav">
   {menus.map(([url,label])=><a href={url} aria-current={active===url?'page':undefined}>{label}</a>)}
   <details class="more-menu"><summary>More <span aria-hidden="true">⌄</span></summary><div class="more-content">
    <a href="/world-news/">World News</a><a href="/us-news/">U.S. News</a><a href="/us-politics/">Politics</a>
    <a href="/business/">Business</a><a href="/science/">Science</a><a href="/technology/">Technology</a>
    <a href="/environment/">Environment</a><a href="/newspapers/">Daily Newspapers</a>
    <a href="/investigations/">Investigations</a><a href="/satrn-audio/">SATRN Audio</a><a href="https://satrn.tv/" target="_blank" rel="noopener noreferrer">SATRN.TV ↗</a>
   </div></details>
   <a class="search-nav" href="/search/" aria-label="Search SATRN News"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></a>
  </nav>
  <details class="mobile-nav"><summary>☰ Menu</summary><div class="mobile-nav-items">{[...menus,['/newspapers/','Newspapers'],['/world-news/','World News'],['/us-news/','U.S. News'],['/technology/','Technology'],['/search/','Search']].map(([url,label])=><a href={url}>{label}</a>)}</div></details>
 </div></header>
 <main id="main"><slot/></main>
 <footer class="footer"><div class="page-container footer-columns">
  <div class="footer-about"><img src="/satrn-news-logo-light.svg" alt="SATRN News" width="174" height="53"/><p>Independent, informed, investigative. News and intelligence for a complex world.</p><strong>QUESTION EVERYTHING.</strong></div>
  <div><h3>EXPLORE</h3><a href="/news/">News</a><a href="/janus-intelligence/">Intelligence</a><a href="/opinion/">Opinion</a><a href="/markets/">Markets</a><a href="/culture/">Culture</a><a href="/lifestyle/">Lifestyle</a></div>
  <div><h3>QUICK LINKS</h3><a href="/about/">About Us</a><a href="/contact/">Contact Us</a><a href="/newspapers/">Daily Newspaper</a><a href="/editorial-standards/">Editorial Standards</a><a href="/corrections-policy/">Corrections</a></div>
  <div><h3>RESOURCES</h3><a href="https://satrn.tv/" target="_blank" rel="noopener noreferrer">SATRN.TV ↗</a><a href="/government-resources/">Government Resources</a><a href="/ai-automation-disclosure/">AI Disclosure</a><a href="/privacy-policy/">Privacy</a></div>
  <div><h3>NEWSLETTER</h3><p>Get informed. Get ahead. Join the conversation.</p><span class="footer-subscribe">Subscription system coming soon.</span></div>
 </div><div class="page-container footer-bottom"><span>© {new Date().getFullYear()} SATRN News. All rights reserved.</span><span><a href="/privacy-policy/">Privacy</a> · <a href="/editorial-standards/">Editorial Standards</a> · <a href="/contact/">Contact</a></span></div></footer>
 <script>
 // The design preview uses external images; if a remote asset fails, show a branded fallback
 // instead of Safari's broken-image glyph. Preserve all working images unchanged.
 document.addEventListener('error',(event)=>{
  const img=event.target;
  if(!(img instanceof HTMLImageElement)||!img.currentSrc.includes('images.unsplash.com'))return;
  const host=img.parentElement;
  if(!host)return;
  host.classList.add('satrn-image-fallback');
  img.remove();
 },true);
 const today=document.getElementById('today-dc');
 const time=document.getElementById('today-time');
 const now=new Date();
 if(today) today.textContent=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'long',month:'long',day:'numeric',year:'numeric'}).format(now);
 if(time) time.textContent=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',hour:'2-digit',minute:'2-digit',hour12:true}).format(now)+' ET';
 </script>
</body></html>
