---
import Layout from '../../layouts/SiteLayout.astro';
import editions from '../../data/editions.json';
const published=editions.filter(e=>e.status==='published').sort((a,b)=>b.date.localeCompare(a.date));
---
<Layout title="Digital Newspapers" active="/newspapers/">
<div class="container archive-header"><div class="kicker">SATRN DAILY SOURCE · SPECIAL INVESTIGATIONS</div><h1>Digital Newspaper Archive</h1><p>Complete daily issues and investigative editions, preserved with their original page layouts.</p></div>
<div class="container section archive-content">{published.length>0?<div class="cards-3">{published.map(e=><article class="news-card edition-card"><div class="kicker">{e.date} · {e.pages} PAGES</div><h3>{e.title}</h3><p>{e.summary}</p><a href={e.url} target="_blank" rel="noopener noreferrer">Read complete edition ↗</a></article>)}</div>:<div class="launch-note"><strong>SATRN News digital editions will appear here.</strong><p>The Daily Source archive and original newspaper page designs will be imported after verification.</p></div>}</div>
</Layout>
