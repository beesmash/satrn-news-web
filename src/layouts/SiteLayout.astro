---
import '../styles/site.css';
const { title = 'SATRN News', description = 'Independent journalism, global reporting, and special investigations.', active = '' } = Astro.props;
const links = [
  ['/', 'Home'], ['/news/', 'News'], ['/world/', 'World'], ['/politics/', 'Politics'],
  ['/business/', 'Business'], ['/technology/', 'Technology'], ['/investigations/', 'Investigations'],
  ['/newspapers/', 'Digital Newspaper'], ['/live/', 'SATRN LIVE']
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'SATRN News' ? title : title + ' | SATRN News'}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="topbar"><div class="wrap topbar-inner"><span>INDEPENDENT REPORTING · GLOBAL PERSPECTIVE</span><span>WASHINGTON, D.C.</span></div></div>
    <header class="site-header">
      <div class="wrap brand-row"><a class="brand" href="/" aria-label="SATRN News home"><span class="brand-satrn">SATRN</span><span class="brand-news">NEWS</span></a><div class="brand-tagline">The Global Newsroom</div></div>
      <nav class="nav" aria-label="Primary navigation"><div class="wrap nav-inner">
        {links.map(([url,label]) => <a href={url} aria-current={active === url ? 'page' : undefined}>{label}</a>)}
      </div></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer"><div class="wrap footer-grid"><div><strong>SATRN NEWS</strong><p>Independent reporting, analysis and global perspective.</p></div><div><span class="footer-label">NEWSROOM</span><a href="/about/">About</a><a href="/newspapers/">Digital Editions</a><a href="/live/">SATRN LIVE</a></div><div><span class="footer-label">EDITORIAL</span><p>Articles and newspaper editions require verification and editorial approval before publication.</p></div></div><div class="wrap footer-bottom">© {new Date().getFullYear()} SATRN News. All rights reserved. · Staging edition</div></footer>
  </body>
</html>
