---
const { article } = Astro.props;
const href = '/news/' + article.slug + '/';
---
<article class="story-card">
  {article.image && <a href={href}><img src={article.image} alt={article.imageAlt || ''} loading="lazy" /></a>}
  <div class="eyebrow">{article.category} · {article.date}</div>
  <h3><a href={href}>{article.title}</a></h3>
  <p>{article.summary}</p>
  <a class="text-link" href={href}>Read report <span aria-hidden="true">↗</span></a>
</article>
