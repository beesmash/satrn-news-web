---
import Layout from '../../layouts/SiteLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import articles from '../../data/articles.json';
const published = articles.filter(a=>a.status === 'published').sort((a,b)=>b.date.localeCompare(a.date));
---
<Layout title="Latest News" active="/news/"><div class="container archive-header"><div class="kicker">SATRN NEWSROOM</div><h1>Latest News</h1><p>Independent reporting, international affairs, finance, investigations and technology.</p></div><div class="container section archive-content">{published.length > 0?<div class="cards-5">{published.map(a=><StoryCard article={a}/>)}</div>:<div class="launch-note"><strong>Editorial content is being prepared.</strong><p>Published and verified SATRN News reporting will appear here.</p></div>}</div></Layout>
