---
import Layout from '../../layouts/SiteLayout.astro';
import articles from '../../data/articles.json';
export function getStaticPaths(){
 return articles.filter(a=>a.status==='published').map(a=>({params:{slug:a.slug},props:{article:a}}));
}
const {article}=Astro.props;
---
<Layout title={article.title} description={article.summary}>
<div class="container article-shell"><article class="article">
 <div class="kicker">{article.category} · {article.storyType||'News'}</div>
 <h1>{article.title}</h1>
 <p class="article-dek">{article.subheadline||article.summary}</p>
 <div class="article-meta-box"><span>By {article.author||'SATRN News'} · {article.date}</span>{article.verification && <span>Verification: {article.verification}</span>}</div>
 {article.image && <figure class="article-featured"><img src={article.image} alt={article.imageAlt||''}/>{article.imageCaption && <figcaption>{article.imageCaption}</figcaption>}</figure>}
 <div class="article-content">{(article.paragraphs||[]).map(p=><p>{p}</p>)}</div>
 {article.sources?.length>0 && <div class="sources"><strong>Sources and attribution</strong><ul>{article.sources.map(s=><li>{s.url?<a href={s.url} rel="noopener noreferrer" target="_blank">{s.title||s.url}</a>:s.title}</li>)}</ul></div>}
 {article.audioUrl && <div class="audio-player"><h3>Listen to this report</h3><audio controls preload="none" src={article.audioUrl}></audio></div>}
 </article><aside class="sidebar"><h3>More from SATRN News</h3><a href="/news/">Latest News →</a><a href="/newspapers/">Digital Newspaper →</a><a href="https://satrn.tv/" target="_blank" rel="noopener noreferrer">SATRN.TV ↗</a></aside></div>
</Layout>
