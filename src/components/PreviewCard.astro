---
const { story, variant='standard', showDate=true, showSummary=false }=Astro.props;
const isNetworkPreview=variant==='video' && story.preview;
const href=isNetworkPreview?'https://satrn.tv/':story.slug?'/news/'+story.slug+'/':'/'+(story.section||'news')+'/';
---
<article class={'pv-card pv-'+variant}>
 <a class="pv-media" href={href} target={isNetworkPreview?'_blank':undefined} rel={isNetworkPreview?'noopener noreferrer':undefined} aria-label={isNetworkPreview?'Visit SATRN.TV network':story.preview?'Explore '+story.category+' desk':story.title}>
  {story.image && <img src={story.image} loading={story.preview ? "eager" : "lazy"} decoding="async" alt="" referrerpolicy="no-referrer"/>}
  {variant==='video' && <span class="video-play" aria-hidden="true">▶</span>}
 </a>
 <div class="pv-copy">
  <span class="pv-category">{story.category}</span>
  <h3><a href={href}>{story.title}</a></h3>
  {showDate && <div class="pv-meta">{story.preview?'ILLUSTRATIVE · ':''}{story.date}</div>}
  {showSummary && story.summary && <p>{story.summary}</p>}
 </div>
</article>
